{
  "manifest_version": 3,
  "name": "JobPilot · BOSS 页面连接器",
  "description": "将求职者明确选择的 BOSS 标签页连接到本机 JobPilot。",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["storage"],
  "host_permissions": [
    "https://zhipin.com/*",
    "https://*.zhipin.com/*",
    "http://127.0.0.1:4317/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "连接当前 BOSS 标签页",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://zhipin.com/*", "https://*.zhipin.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
